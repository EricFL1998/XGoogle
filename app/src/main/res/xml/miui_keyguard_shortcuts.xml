<?xml version="1.0" encoding="utf-8"?>
<!-- Read by HyperOS's lock screen shortcut picker (com.miui.aod) through the
     "miui_keyguard_shortcuts" meta-data. Tags must match KeyguardShortcutHooks.TAGS. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <intent
        android:name="@string/shortcut_assistant"
        android:icon="@drawable/ic_shortcut_assistant"
        android:tag="coogle_assistant"
        android:action="android.intent.action.ASSIST"
        android:targetPackage="com.google.android.googlequicksearchbox" />
    <intent
        android:name="@string/shortcut_lens"
        android:icon="@drawable/ic_shortcut_lens"
        android:tag="coogle_lens"
        android:action="android.intent.action.VIEW"
        android:data="googleapp://lens"
        android:targetPackage="com.google.android.googlequicksearchbox" />
    <intent
        android:name="@string/shortcut_wallet"
        android:icon="@drawable/ic_shortcut_wallet"
        android:tag="coogle_wallet"
        android:action="android.intent.action.MAIN"
        android:targetPackage="com.google.android.apps.walletnfcrel"
        android:targetClass="com.google.commerce.tapandpay.android.wallet.WalletActivity" />
    <intent
        android:name="@string/shortcut_home"
        android:icon="@drawable/ic_shortcut_home"
        android:tag="coogle_home"
        android:action="android.intent.action.MAIN"
        android:targetPackage="com.android.systemui"
        android:targetClass="com.android.systemui.controls.ui.ControlsActivity" />
</shortcuts>
